{
"name": "@nocturnium/svelte-ide",
  "version": "1.0.0-rc.1",
  "description": "Svelte 5 code editor and IDE building blocks — custom editor, syntax highlighting, code folding, multi-cursor, LSP client, and optional realtime collaboration.",
  "author": "Nocturnium & Jordan Dziat <hello@nocturnium.ai> (https://nocturnium.ai)",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/styles/theme.css",
    "./stores": {
      "types": "./dist/stores/index.d.ts",
      "svelte": "./dist/stores/index.js",
      "default": "./dist/stores/index.js"
    },
    "./components/editor": {
      "types": "./dist/components/editor/index.d.ts",
      "svelte": "./dist/components/editor/index.js",
      "default": "./dist/components/editor/index.js"
    },
    "./components/core": {
      "types": "./dist/components/core/index.d.ts",
      "svelte": "./dist/components/core/index.js",
      "default": "./dist/components/core/index.js"
    },
    "./components/ai": {
      "types": "./dist/components/ai/index.d.ts",
      "svelte": "./dist/components/ai/index.js",
      "default": "./dist/components/ai/index.js"
    },
    "./components/layout": {
      "types": "./dist/components/layout/index.d.ts",
      "svelte": "./dist/components/layout/index.js",
      "default": "./dist/components/layout/index.js"
    },
    "./components/lsp": {
      "types": "./dist/components/lsp/index.d.ts",
      "svelte": "./dist/components/lsp/index.js",
      "default": "./dist/components/lsp/index.js"
    },
    "./components/agents": {
      "types": "./dist/components/agents/index.d.ts",
      "svelte": "./dist/components/agents/index.js",
      "default": "./dist/components/agents/index.js"
    },
    "./components/vfs": {
      "types": "./dist/components/vfs/index.d.ts",
      "svelte": "./dist/components/vfs/index.js",
      "default": "./dist/components/vfs/index.js"
    },
    "./components/plugins": {
      "types": "./dist/components/plugins/index.d.ts",
      "svelte": "./dist/components/plugins/index.js",
      "default": "./dist/components/plugins/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "svelte": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "svelte": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "svelte": "./dist/plugins/index.js",
      "default": "./dist/plugins/index.js"
    },
    "./crdt": {
      "types": "./dist/crdt/index.d.ts",
      "svelte": "./dist/crdt/index.js",
      "default": "./dist/crdt/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:lib": "npm run package",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && node scripts/strip-dist-tests.mjs && publint",
    "prepublishOnly": "npm run check && npm run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist .svelte-kit node_modules/.vite"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "y-protocols": "^1.0.6",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.20"
  },
  "peerDependenciesMeta": {
    "yjs": {
      "optional": true
    },
    "y-protocols": {
      "optional": true
    },
    "y-websocket": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@playwright/test": "^1.57.0",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/package": "^2.3.11",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.0",
    "eslint-plugin-svelte": "^3.9.0",
    "globals": "^16.2.0",
    "prettier": "^3.7.0",
    "prettier-plugin-svelte": "^3.4.0",
    "publint": "^0.3.0",
    "svelte": "^5.28.0",
    "svelte-check": "^4.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^2.1.0",
    "yjs": "^13.6.31"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "code-editor",
    "syntax-highlighting",
    "code-folding",
    "lightweight",
    "crdt",
    "yjs",
    "collaboration",
    "codemirror-alternative"
  ],
  "homepage": "https://github.com/nocturnium/svelte-ide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nocturnium/svelte-ide.git"
  },
  "bugs": {
    "url": "https://github.com/nocturnium/svelte-ide/issues"
  }
}
