{
	"name": "@nocturnium/svelte-ide",
	"version": "2.0.1",
	"description": "Svelte 5 code editor and IDE building blocks — custom editor, syntax highlighting, code folding, multi-cursor, LSP client, and optional realtime collaboration.",
	"author": "Nocturnium & Jordan Dziat <hello@nocturnium.ai> (https://nocturnium.ai)",
	"license": "MIT",
	"type": "module",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./theme.css": "./dist/styles/theme.css",
		"./stores": {
			"types": "./dist/stores/index.d.ts",
			"svelte": "./dist/stores/index.js",
			"default": "./dist/stores/index.js"
		},
		"./components/editor": {
			"types": "./dist/components/editor/index.d.ts",
			"svelte": "./dist/components/editor/index.js",
			"default": "./dist/components/editor/index.js"
		},
		"./components/core": {
			"types": "./dist/components/core/index.d.ts",
			"svelte": "./dist/components/core/index.js",
			"default": "./dist/components/core/index.js"
		},
		"./components/ai": {
			"types": "./dist/components/ai/index.d.ts",
			"svelte": "./dist/components/ai/index.js",
			"default": "./dist/components/ai/index.js"
		},
		"./components/layout": {
			"types": "./dist/components/layout/index.d.ts",
			"svelte": "./dist/components/layout/index.js",
			"default": "./dist/components/layout/index.js"
		},
		"./components/lsp": {
			"types": "./dist/components/lsp/index.d.ts",
			"svelte": "./dist/components/lsp/index.js",
			"default": "./dist/components/lsp/index.js"
		},
		"./components/agents": {
			"types": "./dist/components/agents/index.d.ts",
			"svelte": "./dist/components/agents/index.js",
			"default": "./dist/components/agents/index.js"
		},
		"./components/vfs": {
			"types": "./dist/components/vfs/index.d.ts",
			"svelte": "./dist/components/vfs/index.js",
			"default": "./dist/components/vfs/index.js"
		},
		"./components/plugins": {
			"types": "./dist/components/plugins/index.d.ts",
			"svelte": "./dist/components/plugins/index.js",
			"default": "./dist/components/plugins/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"svelte": "./dist/types/index.js",
			"default": "./dist/types/index.js"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"svelte": "./dist/utils/index.js",
			"default": "./dist/utils/index.js"
		},
		"./plugins": {
			"types": "./dist/plugins/index.d.ts",
			"svelte": "./dist/plugins/index.js",
			"default": "./dist/plugins/index.js"
		},
		"./services": {
			"types": "./dist/services/index.d.ts",
			"svelte": "./dist/services/index.js",
			"default": "./dist/services/index.js"
		},
		"./crdt": {
			"types": "./dist/crdt/index.d.ts",
			"svelte": "./dist/crdt/index.js",
			"default": "./dist/crdt/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:lib": "npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && node scripts/strip-dist-tests.mjs && node scripts/check-dist.mjs && publint",
		"prepublishOnly": "npm run check && npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"clean": "rm -rf dist .svelte-kit node_modules/.vite"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"y-protocols": "^1.0.6",
		"y-websocket": "^2.0.4 || ^3.0.0",
		"yjs": "^13.6.20"
	},
	"peerDependenciesMeta": {
		"yjs": {
			"optional": true
		},
		"y-protocols": {
			"optional": true
		},
		"y-websocket": {
			"optional": true
		}
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^10.0.1",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@playwright/test": "^1.64.1",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.6",
		"acorn": "^8.19.0",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.25",
		"semantic-release": "^25.0.9",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"y-protocols": "^1.0.7",
		"y-websocket": "^3.1.0",
		"yjs": "^13.6.33"
	},
	"overrides": {
		"minimatch": "^11.0.3",
		"npm": "^12.2.1",
		"cookie": "^2.0.1"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"code-editor",
		"syntax-highlighting",
		"code-folding",
		"lightweight",
		"crdt",
		"yjs",
		"collaboration",
		"codemirror-alternative"
	],
	"homepage": "https://github.com/nocturnium/svelte-ide#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nocturnium/svelte-ide.git"
	},
	"bugs": {
		"url": "https://github.com/nocturnium/svelte-ide/issues"
	}
}
